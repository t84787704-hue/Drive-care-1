// Firebase Firestore Security Rules for DriveCare
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and user-owned data collections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
